# Every environment variable the app reads.
#
# Base URL of the patient-booking backend, no trailing slash. The browser never calls it
# directly: Next proxies /api/* to it (see next.config.ts). Rewrites are fixed at build time,
# so changing it requires a rebuild / redeploy. Required.
#   dev:    https://patient-booking-backend-678q.onrender.com   (set in .env.development)
#   Vercel: set in Project Settings → Environment Variables, e.g. https://your-backend.example.com
API_URL=http://localhost:8080
